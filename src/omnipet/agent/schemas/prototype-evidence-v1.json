{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipet.dev/schemas/prototype-evidence-v1.json",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pet_id", "design_revision", "pose_id", "artifact", "verdicts", "accepted_warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "pet_id": {"type": "string", "minLength": 1},
    "design_revision": {"type": "string", "minLength": 1},
    "pose_id": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural", "view-semantic", "identity", "pose-purpose"],
      "properties": {
        "structural": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer_role", "reviewer_principal_id", "criteria"], "properties": {"decision": {"type": "string", "enum": ["pass", "warning", "fail"]}, "reviewer_role": {"type": "string", "enum": ["deterministic"]}, "reviewer_principal_id": {"type": "string", "minLength": 1}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        "view-semantic": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer_role", "reviewer_principal_id", "criteria"], "properties": {"decision": {"type": "string", "enum": ["pass", "warning", "fail"]}, "reviewer_role": {"type": "string", "enum": ["production-agent", "independent-visual-reviewer"]}, "reviewer_principal_id": {"type": "string", "minLength": 1}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        "identity": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer_role", "reviewer_principal_id", "criteria"], "properties": {"decision": {"type": "string", "enum": ["pass", "warning", "fail"]}, "reviewer_role": {"type": "string", "enum": ["production-agent", "independent-visual-reviewer"]}, "reviewer_principal_id": {"type": "string", "minLength": 1}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
        "pose-purpose": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer_role", "reviewer_principal_id", "criteria"], "properties": {"decision": {"type": "string", "enum": ["pass", "warning", "fail"]}, "reviewer_role": {"type": "string", "enum": ["production-agent", "independent-visual-reviewer"]}, "reviewer_principal_id": {"type": "string", "minLength": 1}, "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
      }
    },
    "accepted_warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
